APP_MODE=demo
# Account registration and login (Supabase Project Connect / API Keys).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# PLATFORM_OWNER_EMAIL=your-login-email@example.com
# PUBLIC_APP_URL=https://your-site.example
# Optional: set false to disable shared-key migration access before owner claim.
# ALLOW_LEGACY_HOST_LOGIN=false
# Host setup requires DATABASE_URL, SESSION_SECRET and a random ADMIN_ACCESS_KEY (32+ characters).
# ADMIN_ACCESS_KEY=
# Required in live mode. Dates must include a UTC offset.
# DATABASE_URL=postgresql://...
# SESSION_SECRET=use-at-least-32-random-characters
# EVENT_START=2026-12-01T09:00:00+08:00
# EVENT_END=2026-12-08T09:00:00+08:00
# GENERATION_CAP=100
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# GEMINI_JUDGE_API_KEY=
